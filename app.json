{
  "expo": {
    "name": "CALABARZON Explore",
    "slug": "calabarzon-virtual-tour",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "ph.calabarzon.virtualtour",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to attach destination images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "47d55df4-9605-49b1-824c-09cd7ebad8f7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47d55df4-9605-49b1-824c-09cd7ebad8f7"
    }
  }
}
